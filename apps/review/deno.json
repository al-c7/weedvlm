{
  "tasks": {
    "serve": "deno run --allow-net --allow-read --allow-write server.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write server.ts",
    "gen-fixtures": "deno run --allow-read --allow-write fixtures/generate.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check server.ts fixtures/generate.ts"
  },
  "imports": {
    "@std/cli/parse-args": "jsr:@std/cli@^1/parse-args",
    "@std/path": "jsr:@std/path@^1",
    "hyparquet": "npm:hyparquet@^1.33.0",
    "hyparquet-compressors": "npm:hyparquet-compressors@^1.1.3"
  },
  "fmt": {
    "lineWidth": 100
  },
  "compilerOptions": {
    "strict": true
  }
}
