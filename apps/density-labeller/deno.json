{
  "tasks": {
    "serve": "deno run --allow-net --allow-read --allow-write server.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write server.ts",
    "test": "deno test",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check server.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli/parse-args": "jsr:@std/cli@^1/parse-args",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "fmt": {
    "lineWidth": 100
  },
  "compilerOptions": {
    "strict": true
  }
}
